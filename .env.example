# Copy this file to .env and replace the placeholder values before running services.
#
# Local API mode: use POSTGRES_HOST=localhost and REDIS_HOST=localhost.
# Compose API mode: use POSTGRES_HOST=postgres and REDIS_HOST=redis.

# Docker Compose
COMPOSE_PROJECT_NAME=web-forum
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL 16
POSTGRES_USER=forum_user
POSTGRES_PASSWORD=change_this_local_postgres_password
POSTGRES_DB=forum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=127.0.0.1:5432:5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=127.0.0.1:6379:6379

# Published API port for Docker Compose
API_HOST_PORT=127.0.0.1:8080:8080

# JWT -- use a long, unique secret in the real .env file.
JWT_ISSUER=web-forum
JWT_AUDIENCE=web-forum-clients
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Redis-backed feature settings
CACHE_TTL_SECONDS=300
VIEW_WINDOW_MINUTES=30
VIEW_FLUSH_INTERVAL_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CONTENT_RATE_LIMIT_REQUESTS=20
CONTENT_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning
