# Docker Compose
COMPOSE_PROJECT_NAME=web-forum
COMPOSE_PROFILES=runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL 16
POSTGRES_USER=forum_user
POSTGRES_PASSWORD=change_this_local_postgres_password
POSTGRES_DB=forum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=127.0.0.1:5432:5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=127.0.0.1:6379:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_SYNC_TIMEOUT_MS=5000

# Published API port for Docker Compose
API_HOST_PORT=127.0.0.1:8080:8080

# JWT -- use a long, unique secret in the real .env file.
JWT_ISSUER=web-forum
JWT_AUDIENCE=web-forum-clients
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# PBKDF2 iteration count for ASP.NET Core password hashing (minimum 10000).
PASSWORD_HASH_ITERATIONS=100000

# Topic pagination
TOPICS_DEFAULT_PAGE_SIZE=20
TOPICS_MAX_PAGE_SIZE=50

# Redis-backed feature settings
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=forum:cache
VIEW_WINDOW_MINUTES=30
VIEW_FLUSH_INTERVAL_SECONDS=60
VIEW_SEEN_KEY_PREFIX=forum:view:seen
VIEW_COUNTER_KEY_PREFIX=forum:view:counter
VIEW_DIRTY_TOPICS_KEY=forum:view:dirty-topics
VISITOR_COOKIE_NAME=forum_visitor
VISITOR_COOKIE_DAYS=365
VISITOR_COOKIE_SAME_SITE=Lax
VISITOR_COOKIE_SECURE=false
RATE_LIMIT_KEY_PREFIX=forum:rate-limit
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CONTENT_RATE_LIMIT_REQUESTS=20
CONTENT_RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning
